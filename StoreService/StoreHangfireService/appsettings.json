{
  "ServiceType": "Worker",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Hangfire": "Information"
    }
  },
  "Serilog": {
    "Name": "ServiceFile",
    "MinimumLevel": {
      "Default": "Information",
      "Overwrite": {
        "Name": "Microsoft",
        "Level": "Error"
      }
    },
    "Enrich": [ "WithHangfireContext" ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "/storeworker/storeworker-.log",
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 60,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "StoreHangfire",
        "Args": {
          "restrictedToMinimumLevel": "Information"
        }
      }
    ]
  },
  "ExcludesMessage": [
    "/health"
  ],
  "ExcludesApiEndpoint": [
    "/health"
  ],
  "AllowedHosts": "*",
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://*:51003"
      }
    }
  },
  "SupportSetting": [
    {
      "SiteId": 1,
      "CurrencyIds": [ 2, 4, 15 ]
    }
  ]
}
