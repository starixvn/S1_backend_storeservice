{
  "profiles": {
    "StoreService": {
      "commandName": "Project",
      "commandLineArgs": "Nova", // Nova or Leobet
      "launchBrowser": true,
      "applicationUrl": "http://localhost:5000",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  },
  "Docker": {
    "commandName": "Docker",
    "launchBrowser": false,
    "publishAllPorts": true,
    "useSSL": true,
    "environmentVariables": {
      "ASPNETCORE_ENVIRONMENT": "Development"
    }
  }
}
