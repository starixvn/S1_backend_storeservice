{
    "env": "PROD",
    "ServiceType": "API",
    "Serilog": {
        "Name": "ServiceFile",
        "MinimumLevel": {
            "Default": "Information",
            "Overwrite": {
                "Name": "Microsoft",
                "Level": "Error"
            }
        },
        "WriteTo": [
            {
                "Name": "Console",
                "Args": {
                    "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
                }
            }
        ]
    },
    "ConfigService": [ "http://ne-s1-config-service-prod-service:5000/" ],
    "Sentry": {
        "Dsn": "http://ec150ca467d9035b75bd711184d74998@vn-s1-sentry-prod.nebula.prod/15",
        "SendDefaultPii": true,
        "MaxRequestBodySize": "Always",
        "MinimumBreadcrumbLevel": "Debug",
        "MinimumEventLevel": "Warning",
        "AttachStackTrace": true,
        "Debug": true,
        "DiagnosticLevel": "Error",
        "TracesSampleRate": 1.0,
        "Environment": "PROD"
    }
}
