# localhost
# @url=http://localhost:51001

# StoreService Local
@url=http://52.221.19.140:51001

# 取得兌換商品列表
GET {{url}}/health HTTP/1.1

###
# 取得兌換商品列表
POST {{url}}/api/GiftManagement/GetList HTTP/1.1
Content-Type: application/json

{
    "siteId": 1,
    "currencyId": 2,
    "status": [1, 0],
    "categoryIds": [1],
    "tags": [1],
    "giftName": "",
    "orderByField": "Sort",
    "desc": false
}

###
# 取得兌換商品內容
POST {{url}}/api/GiftManagement/Get HTTP/1.1
Content-Type: application/json

{
    "giftId": 4
}

###
# 新增兌換商品
POST {{url}}/api/GiftManagement/Create HTTP/1.1
Content-Type: application/json

{
    "siteId": 1,
    "currencyId": 2,
    "status": 1,
    "categoryId": 1,
    "tags": [1],
    "point": 130,
    "priceWorth": 1990,
    "showStock": 1,
    "stock": 5,
    "infos": [
        {
            "lang": "en",
            "name": "test_en",
            "description": "test test test",
            "pictureUrl": "/foo/2206161en.jpg"
        },
        {
            "lang": "my",
            "name": "test_my",
            "description": "test test test my",
            "pictureUrl": "/foo/2206161my.jpg"
        }
    ],
    "operator": "System"
}

###
# 修改兌換商品
POST {{url}}/api/GiftManagement/Update HTTP/1.1
Content-Type: application/json

{
    "giftId": 6,
    "status": 0,
    "categoryId": 1,
    "tags": [1],
    "point": 130,
    "priceWorth": 1990,
    "showStock": 0,
    "stock": 5,
    "infos": [
        {
            "lang": "en",
            "name": "test_en",
            "description": "test test test",
            "pictureUrl": "/foo/22061606en.jpg"
        },
        {
            "lang": "my",
            "name": "test_my",
            "description": "test test test my",
            "pictureUrl": "/foo/22061606my.jpg"
        }
    ],
    "operator": "System"
}

###
# 取得商品類別
POST {{url}}/api/GiftManagement/GetCategories HTTP/1.1
Content-Type: application/json

{
    "langCodes": ["en", "my", "cs"]
}

###
# 新增商品類別
POST {{url}}/api/GiftManagement/CreateCategory HTTP/1.1
Content-Type: application/json

{
    "infos": [
        {
            "lang": "id",
            "name": "tttt"
        },
        {
            "lang": "en",
            "name": "tttt"
        }
    ]
}

###
# 修改商品類別
POST {{url}}/api/GiftManagement/UpdateCategory HTTP/1.1
Content-Type: application/json

{
    "categoryId": 7,
    "infos": [
        {
            "lang": "en",
            "name": "yyyyy"
        },
        {
            "lang": "my",
            "name": "yyyy"
        },
        {
            "lang": "id",
            "name": "yyyy"
        }
    ]
}

###
# 取得商品標籤
POST {{url}}/api/GiftManagement/GetTags HTTP/1.1
Content-Type: application/json

{
    "langCodes": ["en", "my", "th"]
}

###
# 新增商品標籤
POST {{url}}/api/GiftManagement/CreateTag HTTP/1.1
Content-Type: application/json

{
    "infos": [
        {
            "lang": "en",
            "name": "test_t_en"
        },
        {
            "lang": "my",
            "name": "test_t_my"
        }
    ]
}

###
# 修改商品標籤
POST {{url}}/api/GiftManagement/UpdateTag HTTP/1.1
Content-Type: application/json

{
    "tagId": 4,
    "infos": [
        {
            "lang": "en",
            "name": "yyy"
        },
        {
            "lang": "my",
            "name": "yyy"
        },
        {
            "lang": "th",
            "name": "yyy"
        }
    ]
}

###
# 取得兌換限制
POST {{url}}/api/GiftManagement/GetRedemptionLimit HTTP/1.1
Content-Type: application/json

{
    "siteId": 1,
}

###
# 設定兌換限制
POST {{url}}/api/GiftManagement/SetRedemptionLimit HTTP/1.1
Content-Type: application/json

{
    "siteId": 1,
    "status": 1,
    "limit": 1,
    "operator": "System"
}

###
# 設定商品排序
POST {{url}}/api/GiftManagement/SetSort HTTP/1.1
Content-Type: application/json

{
    "infos": [
        {
            "giftId": 1,
            "sort": 4
        },
        {
            "giftId": 4,
            "sort": 1
        }
    ],
    "operator": "System"
}

