# localhost
# @url=http://localhost:51001

# StoreService Local
@url=http://52.221.19.140:51001

# 取得兌換商品列表
GET {{url}}/health HTTP/1.1

###
# 取得兌換商品列表
POST {{url}}/api/GiftManagement/GetList HTTP/1.1
Content-Type: application/json

{
    "siteId": 1,
    "currencyId": 2,
    "status": [1, 0],
    "categoryIds": [1],
    "tags": [1],
    "giftName": "",
    "pageNumber": 1,
    "pageSize": 10
}

###
# 新增兌換商品
POST {{url}}/api/GiftManagement/Create HTTP/1.1
Content-Type: application/json

{
    "siteId": 1,
    "currencyId": 2,
    "status": 1,
    "categoryId": 1,
    "tags": [1],
    "point": 130,
    "priceWorth": 1990,
    "showStock": 1,
    "stock": 5,
    "sort": 1,
    "infos": [
        {
            "lang": "en",
            "name": "test_en",
            "description": "test test test"
        },
        {
            "lang": "my",
            "name": "test_my",
            "description": "test test test my"
        }
    ],
    "operator": "System"
}

###
# 修改兌換商品
