###
# 取得用戶列表(有點數才會有資料)
POST {{url}}/api/Member/GetList HTTP/1.1
Content-Type: application/json

{
    "siteId": 1,
    "currencyIds": [2],
    "vipLevels": [1, 2, 3],
    "userName": "",
    "tpUserName": "",
    "startTime": "2022-06-01T00:00:00+08:00",
    "endTime": "2022-06-30T00:00:00+08:00",
    "pageNumber": 1,
    "pageSize": 10,
}

###
# 取得用戶點數紀錄
POST {{url}}/api/Member/GetRewardPointLog HTTP/1.1
Content-Type: application/json

{
    "custId": 643973,
    "startTime": "2022-06-01T00:00:00+08:00",
    "endTime": "2022-06-30T00:00:00+08:00",
    "pageNumber": 1,
    "pageSize": 10,
}

###
# 手動發放點數
POST {{url}}/api/Member/ManualRewardPoint HTTP/1.1
Content-Type: application/json

{
    "siteId": 1,
    "userName": "anisetestmyr01",
    "point": 30,
    "categoryId": 0,
    "memo": "test2",
    "operator": "Admin"
}

###
# 批次發放點數
POST {{url}}/api/Member/BatchManualRewardPoint HTTP/1.1
Content-Type: application/json

{
    "siteId": 1,
    "infos": [
        {
            "custId": 643973,
            "currencyId": 2,
            "categoryId": 0,
            "point": 10,
            "memo": "test_batch",
        },
        {
            "custId": 643951,
            "currencyId": 15,
            "categoryId": 1,
            "point": 10,
            "memo": "test_batch",
        }
    ],
    "operator": "Admin"
}
