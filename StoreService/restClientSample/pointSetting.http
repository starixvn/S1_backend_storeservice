###
# 取得TpCategory
POST {{url}}/api/BaseData/GetTpCategoryList HTTP/1.1
Content-Type: application/json

{
    "siteId": 1
}

###
# 取得TpGameType
POST {{url}}/api/BaseData/GetTpGameTypeList HTTP/1.1
Content-Type: application/json

{
    "siteId": 1,
    "tpCategoryId": 1
}

###
# 取得VipLevel
POST {{url}}/api/BaseData/GetVipLevelList HTTP/1.1
Content-Type: application/json

{
    "siteId": 1
}

###
# 取得非活躍點數過期設定
POST {{url}}/api/PointSetting/GetInactivePointExpirySetting HTTP/1.1
Content-Type: application/json

{
    "siteId": 1
}

###
# 非活躍點數過期設定
POST {{url}}/api/PointSetting/SetInactivePointExpirySetting HTTP/1.1
Content-Type: application/json

{
    "siteId": 1,
    "status": 0,
    "days": 45,
    "operator": "System"
}

###
# 取得流水點數設定列表
POST {{url}}/api/PointSetting/GetTurnoverPointSettingList HTTP/1.1
Content-Type: application/json

{
    "siteId": 1,
    "currencyId": 2
}

###
# 取得流水點數設定
POST {{url}}/api/PointSetting/GetTurnoverPointSetting HTTP/1.1
Content-Type: application/json

{
    "siteId": 1,
    "currencyId": 2,
    "vipLevel": 1
}

